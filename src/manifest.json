{
	"manifest_version": 2,
	"name": "ZotcardX",
	"version": "3.4.0",
	"description": "Writing card is more smooth, reading card is more smooth.",
	"homepage_url": "https://github.com/Oz/zotcardx",
	"author": "Oz",
	"icons": {
		"48": "chrome/content/images/zotcard@0.5x.png",
		"96": "chrome/content/images/zotcard.png"
	},
	"applications": {
		"zotero": {
			"id": "zotcard@zotero.org",
			"update_url": "https://raw.githubusercontent.com/Oz/zotcardx/main/updates.json",
			"strict_min_version": "6.999",
			"strict_max_version": "9.*.*"
		}
	}
}
